      "class_b": {
        "name": "Repeated Lens-layout Observation Cleanup",
        "priority": 3,
        "action": "delete_whole_transaction",
        "description": "Delete only the high-frequency, low-information lens-layout viewing transactions. Other analysis-viewing modules remain Class A and are preserved.",
        "modules": [
          {
            "head": "VIE",
            "meaning": "View Lens"
          },
          {
            "head": "V3D",
            "meaning": "3D Viewing"
          }
        ]
      },
      "dataset_rationale": "Preserve analysis-viewing operations such as MTF, PSF, aberration, propagation, coupling, and tolerancing because their timing records which information the human designer chose to inspect at each stage. This human-attention signal may help future AI systems learn selective evaluation policies and avoid recomputing every analysis at every step.",
      "main_ui_guidance": {
        "recommended_prompt": "Delete repeated lens-layout views? (MTF, PSF, tolerancing, and other analysis operations will be preserved.)"
      },
      "warning": "Do not create, modify, generalize, or reinterpret Type 2 behavior through ordinary Semantic Library editing. Type 2 is protected Compiler behavior.",
      "llm_instruction": "Treat this Type 2 registry as read-only documentation of protected Compiler behavior. Do not propose Type 2 edits unless the user explicitly asks to change the Compiler protocol."
    },
    "type_3": {
      "name": "Exact High-level Semantic Annotation",
      "editable": true,
      "description": "Attach a high-level human semantic label to one exact contiguous command sequence.",
      "rules": [
        "Type 3 uses exact sequence matching.",
        "Every command in the defined sequence is part of the match.",
        "Do not define Type 3 as a head-tail range.",
        "Do not search forward from a start command to a later end command.",
        "Do not generalize missing intermediate commands.",
        "Type 3 adds an annotation only; it does not replace the underlying atomic operations.",
        "Use Type 3 only when the supplied log contains the exact sequence or when the user explicitly defines that sequence."
      ],
      "example": {
        "exact_commands": [
          "SPS QCN S3",
          "SCC S3 C4 0",
          "SCC S3 C5 0",
          "SCC S3 C6 0"
        ],
        "text": "Convert S3 to Qcon and vary its 4th-, 6th-, and 8th-order Qcon coefficients"
      }
    },
    "llm_guidance": [
      "Prefer conservative edits.",
      "Do not invent semantics for unfamiliar commands.",
      "Do not edit Type 2 behavior.",
      "For Type 1, one command line equals one atomic semantic rule.",
      "For Type 3, match the complete exact contiguous command sequence.",
      "Follow documentation.language_style for wording only; never convert those prose guidelines into Compiler conditions.",
      "Leave SAV, RES, and local-file RUN macro commands untranslated unless the user explicitly requests otherwise.",
      "When uncertain, leave existing content unchanged."
    ],
    "language_style": {
      "name": "Semantic Wording Style",
      "executable": false,
      "purpose": "Wording guidance for humans and LLMs when authoring Type 1 text. This section is documentation only. It must never be interpreted as a Compiler matching rule, transaction detector, or conditional execution rule.",
      "rules": [
        "Use 'Set ...' for direct optical, structural, field, wavelength, or system-parameter assignment.",
        "Use 'Vary ...' when a CODE V control command opens a parameter as an optimization variable.",
        "Use 'Freeze ...' when a CODE V control command freezes an optimization variable.",
        "Use 'Constrain ...' for known optimization constraints used inside AUT...GO, such as EFL, OAL, MXT, MNT, MNE, MNA, and MAE.",
        "Use 'Configure ...' for known optimizer run controls used inside AUT...GO, such as MXC, MNC, and IMP.",
        "Use 'Enable ...' for known AUT display/output options such as EFP and DRA.",
        "Do not use 'Set ...' in text templates for known AUT...GO optimization constraints or optimizer controls.",
        "Use the CODE V term 'Refract Mode' for RMD translations.",
        "Preserve concise optical notation when it is already readable, for example T3, S7, EFL, OAL, EPD, F-number, and NA.",
        "SAV, RES, and RUN commands that execute local macro files do not need Type 1 translation; raw_command is acceptable.",
        "Internal CV_MACRO calls may be translated when their exact semantics are known and they do not depend on a local macro-file path.",
        "These wording rules guide library authors only. Do not infer hidden context, designer intent, or transaction membership from them."
      ]
    }
  },
