{
  "version": 1,
  "documentation": {
    "purpose": "Guidance for humans and LLMs editing this Semantic Library.",
    "type_1": {
      "name": "Atomic Canonical Translation",
      "editable": true,
      "description": "Translate exactly one command line into one atomic semantic operation.",
      "rules": [
        "One Type 1 rule must match exactly one command line.",
        "Do not combine multiple command lines into one Type 1 rule.",
        "Canonical fields must contain only information explicitly and deterministically recoverable from that command.",
        "Do not infer units, previous values, hidden optical state, or designer intent.",
        "Use placeholders in the pattern to capture variable fields.",
        "If the meaning is uncertain, leave the command untranslated. The Compiler will preserve it as raw_command."
      ],
      "example": {
        "pattern": "THI S{surface} {value}",
        "canonical": {
          "operation_type": "set_thickness",
          "surface": "{surface}",
          "value": "{value}"
        },
        "text_template": "Set T{surface} to {value}"
      }
    },
    "type_2": {
      "name": "Protected Compiler Transaction",
      "editable": false,
      "executable_in_library": false,
      "description": "Protected Type 2 semantics used by the Compiler for GUI-opener cleanup, bounded module annotation, and repeated lens-layout observation cleanup. This registry documents the frozen behavior; it is not an editable Type 2 rule table.",
      "global_precedence": [
        "Type 3 structural masks are resolved before Type 2 processing.",
        "Within Type 2, processing priority is Class C > Class A > Class B."
      ],
      "shared_bounded_matcher": {
        "applies_to": [
          "A",
          "B"
        ],
        "rules": [
          "A bounded module candidate starts at a known Type 2 HEAD and closes at a later GO.",
          "If the same HEAD appears again before GO, shrink the candidate start to the later occurrence of that same HEAD.",
          "If a different known Type 2 HEAD appears before GO, abandon the current candidate for that pass.",
          "Class A and Class B use the same bounded-module matching behavior; only their post-match actions differ."
        ]
      },
